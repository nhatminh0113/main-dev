# Copy to .env (never commit .env) and set a real password:
#   cp .env.example .env
#   sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 16)/" .env
# The password is embedded in DATABASE_URL, so keep it URL-safe (hex is fine).

POSTGRES_USER=taskapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskapp

# Host port for the web UI (http://localhost:8080)
FRONTEND_PORT=8080
