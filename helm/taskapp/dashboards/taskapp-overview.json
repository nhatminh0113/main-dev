        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "All handlers combined, from the high-resolution histogram (http_request_duration_highr_seconds).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_highr_seconds_bucket{namespace=\"$namespace\", job=\"taskapp-backend\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{namespace=\"$namespace\", job=\"taskapp-backend\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_highr_seconds_bucket{namespace=\"$namespace\", job=\"taskapp-backend\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "editorMode": "code"
        }
